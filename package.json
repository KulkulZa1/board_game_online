{
  "name": "board-game-online",
  "version": "1.4.0",
  "description": "Real-time 1v1 multiplayer board game platform — 12 games, link sharing, PWA, AI solo mode",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/smoke-test.js",
    "test:full": "node scripts/smoke-check.js",
    "sandbox": "npx serve sandbox -l 3001",
    "build": "node scripts/no-build.js",
    "lint": "node scripts/check-js.js",
    "check": "npm run lint && npm test && npm run test:full",
    "verify:production": "node scripts/verify-production-version.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chess.js": "0.12.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  }
}
